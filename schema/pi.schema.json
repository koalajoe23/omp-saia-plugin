{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pi SAIA Plugin Configuration Schema",
  "description": "Schema for validating pi.json files generated by the SAIA plugin for pi coding agent",
  "type": "object",
  "required": ["provider", "model"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "permission": {
      "type": "object",
      "description": "Tool permission settings for pi",
      "additionalProperties": {
        "type": "string",
        "enum": ["allow", "ask", "deny"]
      }
    },
    "formatter": {
      "type": "object",
      "description": "Formatter configuration (may be empty object)"
    },
    "model": {
      "type": "string",
      "description": "Default model identifier (e.g., 'saia/glm-4.7')",
      "pattern": "^saia/.+"
    },
    "plugin": {
      "type": "array",
      "description": "List of plugins to load",
      "items": {
        "type": "string"
      }
    },
    "last_updated": {
      "type": "string",
      "description": "Timestamp of last configuration update",
      "format": "date-time"
    },
    "provider": {
      "type": "object",
      "required": ["saia"],
      "properties": {
        "saia": {
          "type": "object",
          "required": ["npm", "name", "options", "models"],
          "properties": {
            "npm": {
              "type": "string",
              "const": "@ai-sdk/openai-compatible",
              "description": "NPM package for SAIA provider"
            },
            "name": {
              "type": "string",
              "description": "Provider display name",
              "const": "SAIA (GWDG Chat AI)"
            },
            "options": {
              "type": "object",
              "required": ["baseURL", "apiKey"],
              "properties": {
                "baseURL": {
                  "type": "string",
                  "description": "API base URL",
                  "pattern": "^https?://.+"
                },
                "apiKey": {
                  "type": "string",
                  "description": "API key string or env variable reference",
                  "pattern": "^.*SAIA_API_KEY.*$"
                }
              },
              "additionalProperties": false
            },
            "models": {
              "type": "object",
              "description": "SAIA model configurations",
              "additionalProperties": {
                "$ref": "#/definitions/modelConfig"
              },
              "minProperties": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "definitions": {
    "modelConfig": {
      "type": "object",
      "required": ["name", "options", "limit"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Human-readable model name and description",
          "minLength": 1
        },
        "alias": {
          "type": "boolean",
          "description": "Whether this is a model group alias (not a real model)"
        },
        "id": {
          "type": "string",
          "description": "Model identifier"
        },
        "category": {
          "type": "string",
          "description": "Model category",
          "enum": ["reasoning", "coder", "vision", "medical", "research", "agentic", "large-context", "general"]
        },
        "description": {
          "type": "string",
          "description": "Detailed model description"
        },
        "options": {
          "type": "object",
          "description": "Model-specific options",
          "properties": {
            "enable-tools": {
              "type": "boolean"
            },
            "enable-auto-tool-choice": {
              "type": "boolean"
            },
            "tool-call-parser": {
              "type": "string",
              "enum": ["openai", "anthropic"]
            }
          },
          "additionalProperties": false
        },
        "limit": {
          "type": "object",
          "required": ["context", "output"],
          "properties": {
            "context": {
              "type": "integer",
              "minimum": 1,
              "description": "Maximum context window in tokens"
            },
            "output": {
              "type": "integer",
              "minimum": 1,
              "description": "Maximum output tokens"
            }
          },
          "additionalProperties": false
        },
        "can_reason": {
          "type": "boolean",
          "description": "Whether this model supports chain-of-thought reasoning"
        },
        "attachment": {
          "type": "boolean",
          "description": "Whether this model supports image/file attachment"
        },
        "metadata": {
          "type": "object",
          "description": "Additional model metadata for guidance",
          "properties": {
            "cost_per_1k_tokens": {
              "type": "number",
              "minimum": 0,
              "description": "Estimated cost per 1,000 tokens in USD"
            },
            "estimated_latency": {
              "type": "string",
              "enum": ["fast", "moderate", "slow", "very-slow"],
              "description": "Estimated response latency category"
            },
            "recommended_for": {
              "type": "array",
              "description": "Use cases this model is recommended for",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}