#!/bin/bash
# SAIA Plugin - Pre-push hook for Docker and TypeScript validation

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo_info() { echo -e "${BLUE}[pre-push]${NC} $1"; }
echo_success() { echo -e "${GREEN}[pre-push] ✓${NC} $1"; }
echo_warning() { echo -e "${YELLOW}[pre-push] ⚠${NC} $1"; }
echo_error() { echo -e "${RED}[pre-push] ✗${NC} $1"; }

# Check if Docker is available
if command -v docker &> /dev/null; then
    DOCKER_AVAILABLE=true
else
    DOCKER_AVAILABLE=false
fi

# Check if we're in CI
if [[ -n "${CI:-}" ]]; then
    IN_CI=true
else
    IN_CI=false
fi

MAIN_BRANCH="main"
CURRENT_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "unknown")

# Only run full checks on main branch or if explicitly requested
echo_info "Current branch: $CURRENT_BRANCH"

# TypeScript check
echo_info "Running TypeScript type check..."
cd "$PROJECT_DIR"
if npx tsc --noEmit --skipLibCheck 2>&1 | grep -q "error TS"; then
    echo_error "TypeScript type check failed"
    echo "Please fix the TypeScript errors before pushing."
    exit 1
else
    echo_success "TypeScript type check passed"
fi

# Shell script syntax check
echo_info "Checking shell script syntax..."
ERRORS=0
for script in src/*.sh sandbox/*.sh install*.sh; do
    if [ -f "$script" ]; then
        if bash -n "$script" 2>/dev/null; then
            echo_success "Syntax OK: $script"
        else
            echo_error "Syntax error: $script"
            ERRORS=$((ERRORS + 1))
        fi
    fi
done

if [ $ERRORS -gt 0 ]; then
    echo_error "Shell script syntax errors found"
    exit 1
fi

# JSON validation
echo_info "Validating JSON files..."
ERRORS=0
for json in package.json tsconfig.json schema/*.json pi.json.example; do
    if [ -f "$json" ]; then
        if jq empty "$json" >/dev/null 2>&1; then
            echo_success "JSON valid: $json"
        else
            echo_error "JSON invalid: $json"
            ERRORS=$((ERRORS + 1))
        fi
    fi
done

if [ $ERRORS -gt 0 ]; then
    echo_error "JSON validation errors found"
    exit 1
fi

# Docker build check (only on main branch and if Docker available)
if $DOCKER_AVAILABLE && [[ "$CURRENT_BRANCH" == "$MAIN_BRANCH" || "$IN_CI" == true ]]; then
    echo_info "Building Docker image for verification..."
    
    # Only fail on build errors, not on cache issues
    if docker build -t saia-plugin-prepush-test . 2>&1 | grep -qi "error"; then
        echo_warning "Docker build completed with warnings"
    else
        echo_success "Docker build verification passed"
    fi
    
    # Cleanup test image
    docker rmi saia-plugin-prepush-test 2>/dev/null || true
fi

# Run test suite on main branch
if [[ "$CURRENT_BRANCH" == "$MAIN_BRANCH" ]]; then
    echo_info "Running test suite..."
    if [ -f "test/test.sh" ]; then
        if bash test/test.sh 2>&1; then
            echo_success "Test suite passed"
        else
            echo_warning "Test suite has failures (but allowing push)"
        fi
    fi
fi

echo_info "Pre-push checks completed successfully!"
exit 0
